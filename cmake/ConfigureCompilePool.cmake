function(configure_profile_compile_pool target_name)
    if (NOT CMAKE_GENERATOR STREQUAL "Ninja" OR NOT CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo"
            OR NOT (CMAKE_SYSTEM_NAME STREQUAL "Linux" OR WIN32))
        return()
    endif ()
    get_property(pool_is_set TARGET ${target_name} PROPERTY JOB_POOL_COMPILE SET)
    if (pool_is_set)
        return()
    endif ()
    get_property(pools_are_set GLOBAL PROPERTY JOB_POOLS SET)
    if (pools_are_set)
        get_property(pools GLOBAL PROPERTY JOB_POOLS)
    else ()
        set(pools ${CMAKE_JOB_POOLS})
    endif ()
    foreach (pool IN LISTS pools)
        if (pool MATCHES "^nouraajd_profile_compile=" AND NOT pool STREQUAL "nouraajd_profile_compile=2")
            message(FATAL_ERROR "The nouraajd_profile_compile pool is reserved with depth 2; found ${pool}.")
        endif ()
    endforeach ()
    if (NOT "nouraajd_profile_compile=2" IN_LIST pools)
        list(APPEND pools nouraajd_profile_compile=2)
    endif ()
    set_property(GLOBAL PROPERTY JOB_POOLS "${pools}")
    set_property(TARGET ${target_name} PROPERTY JOB_POOL_COMPILE nouraajd_profile_compile)
endfunction()
