  "states": [
    {
      "id": 0,
      "textStrref": 16585,
      "body": "Welcome to the Seven Suns. I recognize your face; tell me who you are.",
      "entryCondition": {
        "status": "syntax-only",
        "expressions": [
          {
            "kind": "call",
            "name": "NumberOfTimesTalkedTo",
            "arguments": [
              {
                "kind": "integer",
                "value": 0
              }
            ]
          }
        ],
        "evaluated": false
      },
      "edges": [
        0,
        1,
        2
      ],
      "automaticEdge": null
    },
    {
      "id": 1,
      "textStrref": 16589,
      "body": "Joke as you please. Your invented conqueror does not frighten us.",
      "entryCondition": null,
      "edges": [
        3
      ],
      "automaticEdge": 3
    },
    {
      "id": 2,
      "textStrref": 16591,
      "body": "And these companions of yours\u2014how well do they know you?",
      "entryCondition": null,
      "edges": [
        4,
        5,
        6
      ],
      "automaticEdge": null
    },
    {
      "id": 3,
      "textStrref": 16595,
      "body": "Then let us both enjoy the silence. Leave us to our work.",
      "entryCondition": null,
      "edges": [
        7
      ],
      "automaticEdge": 7
    },
    {
      "id": 4,
      "textStrref": 16596,
      "body": "That disappoints me.",
      "entryCondition": null,
      "edges": [
        8
      ],
      "automaticEdge": 8
    },
    {
      "id": 5,
      "textStrref": 16597,
      "body": "A solitary traveler... You are exactly the sort I have been craving.",
      "entryCondition": null,
      "edges": [
        9,
        10,
        11
      ],
      "automaticEdge": null
    },
    {
      "id": 6,
      "textStrref": 16601,
      "body": "Brothers, our meal has arrived. Let us begin.",
      "entryCondition": null,
      "edges": [
        12
      ],
      "automaticEdge": 12
    },
    {
      "id": 7,
      "textStrref": 16602,
      "body": "You again? Tell us why you insist on troubling us.",
      "entryCondition": {
        "status": "syntax-only",
        "expressions": [
          {
            "kind": "call",
            "name": "NumberOfTimesTalkedTo",
            "arguments": [
              {
                "kind": "integer",
                "value": 1
              }
            ]
          }
        ],
        "evaluated": false
      },
      "edges": [
        13,
        14,
        15
      ],
      "automaticEdge": null
    },
    {
      "id": 8,
      "textStrref": 16607,
      "body": "Our customers can afford our prices. Take your questions elsewhere.",
      "entryCondition": null,
      "edges": [
        16
      ],
      "automaticEdge": 16
    },
    {
      "id": 9,
      "textStrref": 16608,
      "body": "Your remarks will be your end. Brothers, these visitors may discover us. Deal with them now.",
      "entryCondition": null,
      "edges": [
        17
      ],
      "automaticEdge": 17
    },
    {
      "id": 10,
      "textStrref": 16609,
      "body": "Would you give up everything to learn what we really are?",
      "entryCondition": {
        "status": "syntax-only",
        "expressions": [
          {
            "kind": "call",
            "name": "NumberOfTimesTalkedTo",
            "arguments": [
              {
                "kind": "integer",
                "value": 2
              }
            ]
          }
        ],
        "evaluated": false
      },
      "edges": [
        18,
        19,
        20
      ],
      "automaticEdge": null
    },
    {
      "id": 11,
      "textStrref": 16613,
      "body": "We trade in stolen faces and identities. We are doppelgangers, and you have offered us new skins.",
      "entryCondition": null,
      "edges": [
        21
      ],
      "automaticEdge": 21
    },
    {
      "id": 12,
      "textStrref": 16614,
      "body": "I have revealed too much. Brothers, these witnesses must become our next meal.",
      "entryCondition": null,
      "edges": [
        22
      ],
      "automaticEdge": 22
    },
    {
      "id": 13,
      "textStrref": 16615,
      "body": "A false face is life itself to us. This skin once belonged to someone else. We are doppelgangers; surrender yours.",
      "entryCondition": null,
      "edges": [
        23
      ],
      "automaticEdge": 23
    }
  ],
  "edges": [
    {
      "id": 0,
      "from": 0,
      "to": 1,
      "replyStrref": 16586,
      "reply": "Call me Foolio Displasius. I have come to ruin your company!",
      "rawFlags": 5,
      "terminal": false,
      "orderedActions": [
        {
          "kind": "call",
          "name": "SetGlobal",
          "arguments": [
            {
              "kind": "string",
              "value": "CheckedSevenSuns"
            },
            {
              "kind": "string",
              "value": "GLOBAL"
            },
            {
              "kind": "integer",
              "value": 2
            }
          ]
        }
      ],
      "reveals": false
    },
    {
      "id": 1,
      "from": 0,
      "to": 2,
      "replyStrref": 16587,
      "reply": "I lead this party. Why do you need our names?",
      "rawFlags": 5,
      "terminal": false,
      "orderedActions": [
        {
          "kind": "call",
          "name": "SetGlobal",
          "arguments": [
            {
              "kind": "string",
              "value": "CheckedSevenSuns"
            },
            {
              "kind": "string",
              "value": "GLOBAL"
            },
            {
              "kind": "integer",
              "value": 2
            }
          ]
        }
      ],
      "reveals": false
    },
    {
      "id": 2,
      "from": 0,
      "to": 3,
      "replyStrref": 16588,
      "reply": "My identity is private. We can dispense with introductions.",
      "rawFlags": 5,
      "terminal": false,
      "orderedActions": [
        {
          "kind": "call",
          "name": "SetGlobal",
          "arguments": [
            {
              "kind": "string",
              "value": "CheckedSevenSuns"
            },
            {
              "kind": "string",
              "value": "GLOBAL"
            },
            {
              "kind": "integer",
              "value": 2
            }
          ]
        }
      ],
      "reveals": false
    },
    {
      "id": 3,
      "from": 1,
      "to": null,
      "replyStrref": null,
      "reply": null,
      "rawFlags": 8,
      "terminal": true,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 4,
      "from": 2,
      "to": 4,
      "replyStrref": 16592,
      "reply": "We are adventurers who have grown close through our journeys.",
      "rawFlags": 1,
      "terminal": false,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 5,
      "from": 2,
      "to": 5,
      "replyStrref": 16593,
      "reply": "We scarcely know one another. Traveling together is convenient.",
      "rawFlags": 1,
      "terminal": false,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 6,
      "from": 2,
      "to": 3,
      "replyStrref": 16594,
      "reply": "I will not discuss my private life with a merchant.",
      "rawFlags": 1,
      "terminal": false,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 7,
      "from": 3,
      "to": null,
      "replyStrref": null,
      "reply": null,
      "rawFlags": 8,
      "terminal": true,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 8,
      "from": 4,
      "to": null,
      "replyStrref": null,
      "reply": null,
      "rawFlags": 8,
      "terminal": true,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 9,
      "from": 5,
      "to": 3,
      "replyStrref": 16598,
      "reply": "Keep your ailments to yourself. I have heard enough.",
      "rawFlags": 1,
      "terminal": false,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 10,
      "from": 5,
      "to": 4,
      "replyStrref": 16599,
      "reply": "Someone who loves me would notice if I disappeared with you.",
      "rawFlags": 1,
      "terminal": false,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 11,
      "from": 5,
      "to": 6,
      "replyStrref": 16600,
      "reply": "Why would someone as wealthy as you take an interest in me?",
      "rawFlags": 1,
      "terminal": false,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 12,
      "from": 6,
      "to": null,
      "replyStrref": null,
      "reply": null,
      "rawFlags": 12,
      "terminal": true,
      "orderedActions": [
        {
          "kind": "call",
