            }
          ]
        }
      ],
      "reveals": true
    },
    {
      "id": 13,
      "from": 7,
      "to": 8,
      "replyStrref": 16605,
      "reply": "If this is a shop, why are you so unwilling to sell us anything?",
      "rawFlags": 1,
      "terminal": false,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 14,
      "from": 7,
      "to": 9,
      "replyStrref": 16603,
      "reply": "A merchant lecturing me about shame? Your hypocrisy is impressive.",
      "rawFlags": 1,
      "terminal": false,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 15,
      "from": 7,
      "to": 9,
      "replyStrref": 16606,
      "reply": "Your voice does not offend me. Give us better answers.",
      "rawFlags": 1,
      "terminal": false,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 16,
      "from": 8,
      "to": null,
      "replyStrref": null,
      "reply": null,
