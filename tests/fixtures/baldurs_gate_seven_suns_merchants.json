    },
    {
      "id": 18,
      "from": 10,
      "to": 11,
      "replyStrref": 16610,
      "reply": "You are impostors. I accept the risk\u2014show us your real faces.",
      "rawFlags": 1,
      "terminal": false,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 19,
      "from": 10,
      "to": 12,
      "replyStrref": 16611,
      "reply": "What truth? I only wanted directions out of here.",
      "rawFlags": 1,
      "terminal": false,
      "orderedActions": [],
      "reveals": false
    },
    {
      "id": 20,
      "from": 10,
      "to": 13,
      "replyStrref": 16612,
      "reply": "Truth matters little to me. I enjoy a convincing fiction too.",
      "rawFlags": 1,
      "terminal": false,
      "orderedActions": [],
      "reveals": false
    },
